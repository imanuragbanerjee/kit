{
  "name": "kit",
  "version": "0.0.0",
  "private": true,
  "description": "Personal shared kit: Tailwind theme, tooling presets and a shadcn registry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imanuragbanerjee/kit.git"
  },
  "workspaces": {
    "packages": [
      "tooling/*",
      "packages/*",
      "fixtures/*"
    ],
    "catalog": {
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "tailwindcss": "^4.3.5",
      "typescript": "^6.0.3"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "oxfmt . && oxlint .",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install || true",
    "registry:build": "turbo run build --filter=@anuragbanerjee/ui",
    "registry:validate": "shadcn registry validate ./registry.json",
    "release": "changeset publish",
    "taze": "taze",
    "taze:fix": "taze -w -i",
    "test:fixtures": "bun scripts/test-fixtures.ts",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run build",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@anuragbanerjee/oxc-config": "workspace:*",
    "@anuragbanerjee/tsconfig": "workspace:*",
    "@astrojs/compiler-rs": "^0.5.3",
    "@changesets/cli": "^3.0.3",
    "@types/node": "catalog:",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "shadcn": "^4.23.0",
    "taze": "^21.3.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "ultracite": "^8.1.1"
  },
  "packageManager": "bun@1.4.4"
}
