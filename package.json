{
  "name": "kit",
  "version": "0.0.0",
  "private": true,
  "description": "Personal shared kit: Tailwind theme, tooling presets and a shadcn registry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imanuragbanerjee/kit.git"
  },
  "workspaces": {
    "packages": [
      "tooling/*",
      "packages/*",
      "fixtures/*"
    ],
    "catalog": {
      "@astrojs/check": "^0.9.12",
      "@astrojs/compiler-rs": "^0.5.3",
      "@astrojs/react": "^7.1.8",
      "@base-ui/react": "^1.9.0",
      "@changesets/changelog-github": "^1.0.1",
      "@changesets/cli": "^3.0.3",
      "@fontsource-variable/geist": "^5.3.0",
      "@fontsource-variable/geist-mono": "^5.3.0",
      "@shadcn/lint": "^0.2.5",
      "@tailwindcss/postcss": "^4.3.5",
      "@tailwindcss/typography": "^0.5.20",
      "@tailwindcss/vite": "^4.3.5",
      "@tanstack/react-router": "^1.170.46",
      "@tanstack/react-start": "^1.169.5",
      "@types/bun": "^1.4.4",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.3.0",
      "astro": "^7.4.11",
      "class-variance-authority": "^0.7.1",
      "cn": "^0.5.2",
      "lefthook": "^2.2.2",
      "next": "^16.4.6",
      "oxfmt": "^0.78.0",
      "oxlint": "^1.93.0",
      "oxlint-tsgolint": "^7.0.2006",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "shadcn": "^4.23.0",
      "tailwindcss": "^4.3.5",
      "taze": "^21.3.0",
      "turbo": "^2.11.11",
      "tw-animate-css": "^1.4.0",
      "typescript": "^6.0.3",
      "ultracite": "^8.2.0",
      "vite": "^8.3.8"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "oxfmt . && oxlint .",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prepare": "lefthook install || true",
    "registry:build": "turbo run build --filter=@anuragbanerjee/ui",
    "registry:validate": "shadcn registry validate ./registry.json",
    "release": "changeset publish",
    "taze": "taze",
    "taze:fix": "taze -w -i",
    "test:fixtures": "turbo run test:registry",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "verify": "bun run format:check && bun run lint && bun run typecheck && bun run build",
    "version-packages": "changeset version",
    "ui:sync": "bun scripts/sync-ui.ts",
    "ui:check": "bun run ui:sync && git diff --exit-code -- packages/ui/src/components/ui"
  },
  "devDependencies": {
    "@anuragbanerjee/oxc-config": "workspace:*",
    "@anuragbanerjee/tsconfig": "workspace:*",
    "@astrojs/compiler-rs": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "shadcn": "catalog:",
    "taze": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
