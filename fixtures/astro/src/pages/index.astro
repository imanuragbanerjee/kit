---
import { ButtonDemo } from "@/components/button-demo";
import "@/styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>kit fixture: Astro</title>
  </head>
  <!-- Base UI: iOS 26+ Safari backdrops need a relative body and an isolated app root. -->
  <body class="relative">
    <div class="isolate min-h-dvh">
      <main class="mx-auto flex max-w-xl flex-col gap-4 p-8">
        <h1>Astro fixture</h1>
        <ButtonDemo client:load />
      </main>
    </div>
  </body>
</html>
