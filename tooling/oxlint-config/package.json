{
  "name": "@anuragbanerjee/oxlint-config",
  "version": "0.1.1",
  "description": "Shared oxlint presets (core, React, Next.js) with Ultracite and shadcn/lint rules.",
  "keywords": [
    "config",
    "oxc",
    "oxlint",
    "shadcn",
    "ultracite"
  ],
  "homepage": "https://github.com/imanuragbanerjee/kit/tree/main/tooling/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/imanuragbanerjee/kit/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imanuragbanerjee/kit.git",
    "directory": "tooling/oxlint-config"
  },
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./next": {
      "types": "./src/next.d.ts",
      "default": "./src/next.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ultracite": "^8.2.0"
  },
  "devDependencies": {
    "@anuragbanerjee/tsconfig": "workspace:*",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@shadcn/lint": ">=0.2.5 <1",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": ">=7.0.2006"
  },
  "peerDependenciesMeta": {
    "@shadcn/lint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  }
}
